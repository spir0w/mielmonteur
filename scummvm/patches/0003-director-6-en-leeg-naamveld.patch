diff --git a/graphics/macgui/mactext.cpp b/graphics/macgui/mactext.cpp
--- a/graphics/macgui/mactext.cpp
+++ b/graphics/macgui/mactext.cpp
@@ -1156,6 +1156,28 @@
 		SWAP(s.startCol, s.endCol);
 	}
 
+	// A selection of no characters, or of blanks only (a game that selects
+	// everything in a field it has not filled yet) highlights nothing: without this the end of an empty line counts as "all
+	// text" below and the whole box is inverted (Mulle Meck's empty name field
+	// came out solid black).
+	if (s.startRow == s.endRow) {
+		bool blank = s.startCol == s.endCol;
+		if (!blank) {
+			// Only blanks on the line (Mulle Meck's name field holds a lone
+			// space): nothing to highlight, and the "to the end of the line"
+			// rule below would invert the whole box.
+			blank = true;
+			for (const MacFontRun &run : _canvas._text[s.startRow].chunks) {
+				for (uint32 i = 0; i < run.text.size(); i++) {
+					if (run.text[i] != ' ' && run.text[i] != '\r' && run.text[i] != '\n' && run.text[i] != '\t')
+						blank = false;
+				}
+			}
+		}
+		if (blank)
+			return;
+	}
+
 	int lastLineStart = s.endY;
 	s.endY += getLineHeight(s.endRow);
 
