diff --git a/engines/director/detection.cpp b/engines/director/detection.cpp
index de1ff403..4803e205 100644
--- a/engines/director/detection.cpp
+++ b/engines/director/detection.cpp
@@ -160,7 +160,178 @@ static char s_fallbacGameIdBuffer[256];
 static char s_fallbackFileNameBuffer[51];
 static char s_fallbackExtraBuf[256];
 
+// Miel Monteur bouwt auto's / Mulle Meck bygger bilar / Autos bauen mit Willy
+// Werkel / Building Cars with Gary Gadget, in any language or release. The
+// table knows a few releases by their projector; the others (the Dutch
+// Levande Böcker and Transposia discs, the download, copies that were
+// installed, discs merged with another language's projector) are recognised
+// by the movies all of them share: the shared casts 00 and CDDATA, the garage
+// (03), the driving map (05) and the car show (94).
+
+static Director::DirectorGameDescription s_mulleBilarDesc = {
+	{
+		"garygadget1",
+		"",
+		AD_ENTRY1(nullptr, nullptr),
+		Common::NL_NLD,
+		Common::kPlatformWindows,
+		ADGF_NO_FLAGS,
+		GUIO0()
+	},
+	Director::GID_GENERIC,
+	600
+};
+
+static char s_mulleBilarFileName[256];
+
+static const char *const kMulleBilarMovies[] = { "00.cxt", "cddata.cxt", "03.dxr", "05.dxr", "94.dxr" };
+
+// A file's name as on the disc: copies made from an ISO can keep the ";1"
+// version and the trailing dot of ISO 9660 names.
+static Common::String mulleFileName(const Common::FSNode &node) {
+	Common::String name = node.getName();
+	size_t semicolon = name.findLastOf(';');
+	if (semicolon != Common::String::npos)
+		name = name.substr(0, semicolon);
+	while (!name.empty() && name.lastChar() == '.')
+		name.deleteLastChar();
+	name.toLowercase();
+	return name;
+}
+
+// The Director version of a Windows projector, from the tag its tail points
+// at; 0 for any other file.
+static uint16 mulleProjectorVersion(const Common::FSNode &node) {
+	Common::File f;
+	if (!f.open(node) || f.size() < 8)
+		return 0;
+	f.seek(-4, SEEK_END);
+	uint32 offset = f.readUint32LE();
+	if (f.eos() || offset == 0 || offset >= (uint32)(f.size() - 4))
+		return 0;
+	f.seek(offset);
+	switch (f.readUint32LE()) {
+	case MKTAG('P', 'J', '9', '5'):
+		return 500;
+	case MKTAG('P', 'J', '9', '7'):
+		return 600;
+	case MKTAG('P', 'J', '0', '0'):
+		return 700;
+	case MKTAG('P', 'J', '0', '1'):
+		return 800;
+	default:
+		return 0;
+	}
+}
+
+struct MulleBilarScan {
+	Common::String moviesDir;	// where the movies are, relative to the game folder ("" for the folder itself)
+	Common::String projector;	// the best projector, relative to the game folder
+	uint16 projectorVersion = 0;
+	int projectorScore = 0;
+	Common::Language language = Common::UNK_LANG;
+	bool foundMovies = false;
+};
+
+static Common::Language mulleLanguageFromName(const Common::String &lowerName) {
+	if (lowerName.contains("miel") || lowerName.contains("monteur"))
+		return Common::NL_NLD;
+	if (lowerName.contains("willy") || lowerName.contains("werkel"))
+		return Common::DE_DEU;
+	if (lowerName.contains("mekk"))
+		return Common::NB_NOR;
+	if (lowerName.contains("mulle") || lowerName.contains("meck"))
+		return Common::SV_SWE;
+	if (lowerName.contains("gary") || lowerName.contains("gadget"))
+		return Common::EN_ANY;
+	return Common::UNK_LANG;
+}
+
+static void scanMulleBilar(const Common::FSList &list, const Common::String &prefix, int depth, MulleBilarScan &scan) {
+	uint found = 0;
+	for (uint i = 0; i < ARRAYSIZE(kMulleBilarMovies); i++) {
+		for (const auto &node : list) {
+			if (!node.isDirectory() && mulleFileName(node) == kMulleBilarMovies[i]) {
+				found++;
+				break;
+			}
+		}
+	}
+	if (found == ARRAYSIZE(kMulleBilarMovies) && !scan.foundMovies) {
+		scan.foundMovies = true;
+		scan.moviesDir = prefix;
+	}
+
+	for (const auto &node : list) {
+		const Common::String name = mulleFileName(node);
+		if (node.isDirectory()) {
+			Common::FSList children;
+			if (depth > 1 && node.getChildren(children, Common::FSNode::kListAll))
+				scanMulleBilar(children, prefix + node.getName() + "/", depth - 1, scan);
+			continue;
+		}
+		if (!name.hasSuffix(".exe") || name.hasPrefix("setup") || name.hasPrefix("install") || name.hasPrefix("unins"))
+			continue;
+		const uint16 version = mulleProjectorVersion(node);
+		if (!version)
+			continue;
+		// The 32-bit Director 6 projector the game was made with (MULLE32.EXE,
+		// WILLY32.EXE, ...) first; the 16-bit one (...16.EXE) only if there is
+		// nothing else.
+		int score = version == 600 ? 30 : 20;
+		if (name.hasSuffix("32.exe"))
+			score += 5;
+		if (name.hasSuffix("16.exe"))
+			score -= 15;
+		if (score > scan.projectorScore) {
+			scan.projectorScore = score;
+			scan.projector = prefix + node.getName();
+			scan.projectorVersion = version;
+		}
+		if (scan.language == Common::UNK_LANG)
+			scan.language = mulleLanguageFromName(name);
+	}
+}
+
+static ADDetectedGame detectMulleBilar(const Common::FSList &fslist, ADDetectedGameExtraInfo **extraInfo) {
+	MulleBilarScan scan;
+	scanMulleBilar(fslist, "", 3, scan);
+	if (!scan.foundMovies)
+		return ADDetectedGame();
+
+	Director::DirectorGameDescription *desc = &s_mulleBilarDesc;
+	Common::String main = scan.projector;
+	desc->version = scan.projectorVersion ? scan.projectorVersion : 600;
+	if (main.empty()) {
+		// No projector (a copy of the movies only): start with the intro.
+		main = scan.moviesDir + "10.DXR";
+	}
+	Common::strlcpy(s_mulleBilarFileName, main.c_str(), sizeof(s_mulleBilarFileName));
+	desc->desc.filesDescriptions[0].fileName = s_mulleBilarFileName;
+	desc->desc.filesDescriptions[0].md5 = nullptr;
+	desc->desc.filesDescriptions[0].fileSize = AD_NO_SIZE;
+	// Nothing in the files says which language they speak but the
+	// projector's name; this build is made for Miel Monteur, so Dutch.
+	desc->desc.language = scan.language != Common::UNK_LANG ? scan.language : Common::NL_NLD;
+
+	warning("Director: Miel Monteur / Mulle Meck bygger bilar recognised by its movies in '%s', starting '%s' (D%d)",
+		scan.moviesDir.empty() ? "." : scan.moviesDir.c_str(), main.c_str(), desc->version / 100);
+
+	if (extraInfo != nullptr) {
+		*extraInfo = new ADDetectedGameExtraInfo;
+		if (desc->desc.language == Common::NL_NLD) {
+			(*extraInfo)->gameName = "Miel Monteur bouwt auto's";
+			(*extraInfo)->targetID = "mielmonteur";
+		}
+	}
+	return ADDetectedGame(&desc->desc);
+}
+
 ADDetectedGame DirectorMetaEngineDetection::fallbackDetect(const FileMap &allFiles, const Common::FSList &fslist, ADDetectedGameExtraInfo **extraInfo) const {
+	ADDetectedGame mulle = detectMulleBilar(fslist, extraInfo);
+	if (mulle.desc)
+		return mulle;
+
 	// TODO: Handle Mac fallback
 
 	// reset fallback description
