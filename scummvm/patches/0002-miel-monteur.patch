diff --git a/engines/director/game-quirks.cpp b/engines/director/game-quirks.cpp
index be976a1d..1870c84c 100644
--- a/engines/director/game-quirks.cpp
+++ b/engines/director/game-quirks.cpp
@@ -292,6 +292,23 @@ static void quirkMulleMeckBilar() {
 	g_director->_pointerArt[Graphics::kMacCursorCrossHair] = "C_Grab";
 	g_director->_pointerArt[Graphics::kMacCursorCrossBar] = "C_Grab";
 	g_director->_drivingArrows = "05n002v0";
+	// Miel Monteur: the Swedish and German projectors (MULLE32.EXE,
+	// Willy32.exe) go straight to the game, but other releases (the Dutch
+	// discs, Transposia's Start.exe) open Levande Böcker's start menu first,
+	// which checks for an installation on the hard disk and otherwise tries to
+	// run the installer ("open ... C:\"). As Bygger båtar: start with the
+	// game's own first movie, 10 (the name screen and title).
+	const Common::String exe = g_director->getRawEXEName();
+	if (!exe.hasSuffixIgnoreCase("MULLE32.EXE") && !exe.hasSuffixIgnoreCase("Willy32.exe") && !exe.hasSuffixIgnoreCase(".DXR")) {
+		static const char *const firstMovies[] = { "MOVIES/10.DXR", "10.DXR", "DATA/MOVIES/10.DXR" };
+		for (const char *movie : firstMovies) {
+			if (SearchMan.hasFile(Common::Path(movie))) {
+				warning("Miel Monteur: starting at %s instead of %s (the disc's start menu)", movie, exe.c_str());
+				g_director->setDefaultStartMovie(movie);
+				break;
+			}
+		}
+	}
 }
 
